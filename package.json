{
  "name": "betmate",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n FRONT,BACK,MICRO -c green,blue,magenta \"npm run dev:front\" \"npm run dev:back\" \"npm run dev:micro\"",
    "dev:front": "npm run dev --prefix frontend",
    "dev:back": "npm run dev --prefix backend",
    "dev:micro": "cd microservice && docker compose up -d",
    "logs:micro": "cd microservice && docker compose logs -f",
    "down:micro": "cd microservice && docker compose down",
    "micro:build": "cd microservice && docker compose build",
    "micro:build:clean": "cd microservice && docker compose build --no-cache",
    "status": "node scripts/status.js",
    "release:frontend": "bash scripts/release-frontend.sh",
    "release:frontend:patch": "bash scripts/release-frontend.sh patch",
    "release:frontend:minor": "bash scripts/release-frontend.sh minor",
    "release:frontend:major": "bash scripts/release-frontend.sh major"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  }
}
