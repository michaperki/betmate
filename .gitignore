# Ignore editor-specific claude settings everywhere
**/.claude/settings.local.json

# Node/NPM artifacts
node_modules/
*/node_modules/

# Build outputs
dist/
*/dist/
build/
*/build/

# Logs and runtime traces
*.log
logs/
*.pid

# Environment files
.env
.env.*

# Coverage and test artifacts
coverage/
*/coverage/

# OS metadata
.DS_Store
Thumbs.db

# Docker junk
docker-data/
*.local.yaml

# Local research, dumps, engines, and utilities (not for version control)
context-dumps/
research/
lc0/
bot-worker/

# Local helper scripts and experiments
scripts/**
!scripts/git-tree-status.sh

# Temporary or scratch files
tmp_style.scss
TEST_ADD.txt

# Loose local markdown notes not intended for version control
CURRENCIES.md
